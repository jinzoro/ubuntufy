#!/usr/bin/env bash
set -euo pipefail
installed="${MOCK_RPM_INSTALLED:?}"
if [ "${1:-}" = "-q" ]; then
  if [ "${2:-}" = "--qf" ]; then
    pkg="${!#}"
    if grep -qx -- "$pkg" "$installed"; then
      printf '%s\n' "${MOCK_RPM_VERSION:-45.0}"
      exit 0
    fi
    exit 1
  fi
  pkg="${2:-}"
  if grep -qx -- "$pkg" "$installed"; then
    exit 0
  fi
  exit 1
fi
if [ "${1:-}" = "-qa" ]; then
  cat "$installed"
  exit 0
fi
exit 0
